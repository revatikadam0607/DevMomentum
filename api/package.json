{
  "name": "devmomentum-api",
  "version": "1.0.0",
  "description": "REST API backend for DevMomentum — placement-preparation planner",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
